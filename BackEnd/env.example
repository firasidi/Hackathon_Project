APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Email (password reset codes) ──
# MAIL_MAILER=log only WRITES the email in storage/logs/laravel.log (nothing is sent).
# To really send it, use smtp. Example with Gmail (needs an "App password", not your normal one):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=null            (port 587 = STARTTLS; for port 465 use MAIL_SCHEME=smtps)
#   MAIL_USERNAME=your.address@gmail.com
#   MAIL_PASSWORD=your-16-letter-app-password
#   MAIL_FROM_ADDRESS=your.address@gmail.com
# For Resend, use an API key and a sender address on a domain verified with Resend:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_your_api_key
#   MAIL_FROM_ADDRESS=no-reply@your-verified-domain.tld
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@insaf.tn"
MAIL_FROM_NAME="Insaf"

# Email of the demo student S001 (reset codes for CIN 12345678 are sent here)
DEMO_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hedera HCS receipt verification
HEDERA_NETWORK=testnet
HEDERA_TOPIC_ID=0.0.123456
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
